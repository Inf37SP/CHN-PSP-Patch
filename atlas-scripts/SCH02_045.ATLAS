#VAR(Table, TABLE)
#ADDTBL("../encoding.tbl", Table)
#ACTIVETBL(Table)
#VAR(PTR, CUSTOMPOINTER)
#CREATEPTR(PTR, "LINEAR", 0, 16)
#JMP($00000294)

#WRITE(PTR, $00000044)
七海ルート有り
<END2>

#WRITE(PTR, $0000004E)
七海ルート無し
<END2>

#WRITE(PTR, $000000F6)
その後も七海の下らない話に散々付き合わされ、ケータイ本体が僕の手許に戻ってきた頃には日も暮れていた。
<END>

#WRITE(PTR, $00000106)
長く、苦痛な数時間だった……。
<LINE>
ようやく七海と別れて帰路につくことができた。
<END>

#WRITE(PTR, $00000116)
もうすっかり秋になったみたいで、少し肌寒さを感じさせる夜風が、頭痛と吐き気のする身には心地いい。
<END>

#WRITE(PTR, $00000126)
人混みの中に長時間いると、僕はいつもこの頭痛と吐き気に苛まれる。
<END>

#WRITE(PTR, $00000136)
七海なんか、氏ねばいいんだ。
<LINE>
死ね、まではいかなくてもいいけど、とにかく氏ね。
<END>

#WRITE(PTR, $00000146)
あいつは自分のことしか考えてない。
<END>

#WRITE(PTR, $00000156)
あいつの行動がどれだけ僕を傷つけているかなんて、どうせこれっぽっちも気付いてないんだろうな。
<END>

#WRITE(PTR, $00000166)
できることなら、今すぐにでも買ったケータイをバキッと真っ二つにして、近くのゴミ箱に捨ててしまいたい。
<LINE>
どうせ僕のお金で買ったものじゃないしね。
<END>

#WRITE(PTR, $00000176)
でもそんなことしたら、七海だけじゃなく両親までやって来て、懲りずにまた“壊れたから新しいケータイを買いに行こう”とか間抜けなことをのたまうに決まってる。
<END>

#WRITE(PTR, $000001D0)
だから僕はやむを得ず、破壊衝動をぐっと抑えた。
<END>

#WRITE(PTR, $000001E0)
早く、帰ろう……。
<LINE>
帰って、今日もエンスーに潜ろう。
<END>

#WRITE(PTR, $000001F0)
ここ数日、ストレスが溜まらない日がない。
<LINE>
僕の平穏な日々が早く戻ってきてくれないかな……。
<END>

<DUMMY>
<DUMMY>
<DUMMY>
<END2>
