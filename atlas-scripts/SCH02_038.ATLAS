#VAR(Table, TABLE)
#ADDTBL("../encoding.tbl", Table)
#ACTIVETBL(Table)
#VAR(PTR, CUSTOMPOINTER)
#CREATEPTR(PTR, "LINEAR", 0, 16)
#JMP($000017C0)

#WRITE(PTR, $00001016)
楠優愛は、自分の部屋でＰＣに向かっていた。
<LINE>
その横顔は真剣そのものであり、モニタに表示された情報を素早く読み取っていく。
<END>

#WRITE(PTR, $00001026)
やがて小さく息をつくとマウスから手を離し、チラリと手許に置かれた紙を見やった。
<END>

#WRITE(PTR, $0000119E)
それは『ナイトハルト』と『将軍』によって交わされたチャットのログを印刷したもので、昨日、西條拓巳に突きつけたのと同じものだ。
<END>

#WRITE(PTR, $000011AE)
【優愛】
「西條くん……」
<END>

#WRITE(PTR, $000011BE)
優愛はポツリとその名をつぶやく。脳裏には、松濤公園のベンチにひとり座る拓巳の背中が思い浮かんだ。それをかき消すように、すぐに小さく首を振る。
<END>

#WRITE(PTR, $0000124C)
と、急にハッとして背後を振り返った。
<END>

#WRITE(PTR, $000012B2)
【優愛】
「今、誰かに、見られていたような……」
<END>

#WRITE(PTR, $000012C2)
彼女の視線の先には、ベッドの上に鎮座するゲロカエルんの大きなぬいぐるみの姿。
<END>

#WRITE(PTR, $000012EE)
気のせいかと首を傾げると、彼女はのろのろと立ち上がり、ベッドまで歩いていってボフッと顔から倒れ込んだ。
<END>

#WRITE(PTR, $000013E8)
シーツからは、太陽の匂いがした。
<END>

#WRITE(PTR, $000013F8)
どうやら昼間、母が布団を干してくれたようだ。
<LINE>
そのホッとする匂いに顔を埋めながら、優愛はぼんやりと視線をさまよわせる。
<END>

#WRITE(PTR, $00001408)
彼女の部屋はとても整頓されており、几帳面な性格を窺わせた。
<END>

#WRITE(PTR, $00001418)
特に、８畳ほどの部屋には不釣り合いな大きな本棚には、隙間すらほとんどないくらいにぴっちりと、たくさんの本が並べられている。
<END>

#WRITE(PTR, $00001428)
ただ、少し微笑ましいのは――
<END>

#WRITE(PTR, $00001438)
下半分がいかにも難しそうな学術書や、ＰＣ関係の書物ばかりであるのに対して、上半分は対照的に少女マンガやアニメのＤＶＤで埋められているということだ。
<END>

#WRITE(PTR, $00001448)
優愛はもう一度ため息をつき、身体を仰向けにして天井を見つめた。
<END>

#WRITE(PTR, $00001470)
【優愛】
「
<DICT>
ＤＩＤ
</DICT>
……」
<END>

#WRITE(PTR, $00001610)
つぶやいたのは、さっきまでＰＣで調べていた、心の病の名。
<END>

#WRITE(PTR, $00001620)
今もモニタには、それに関する説明が表示されていた。
<END>

#WRITE(PTR, $000016C0)
【優愛】
「辛いんですね……」
<END>

#WRITE(PTR, $00001726)
優愛は枕元に置いてある、ゲロカエルんぬいぐるみをギュッと抱きしめ、拓巳のことを想う。
<END>

#WRITE(PTR, $00001736)
【優愛】
「でも……わたし……」
<END>

#WRITE(PTR, $00001746)
だがすぐにその表情を消し、奥歯をギリリと噛みしめた。
<END>
