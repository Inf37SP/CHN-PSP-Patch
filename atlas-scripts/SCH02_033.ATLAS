#VAR(Table, TABLE)
#ADDTBL("../encoding.tbl", Table)
#ACTIVETBL(Table)
#VAR(PTR, CUSTOMPOINTER)
#CREATEPTR(PTR, "LINEAR", 0, 16)
#JMP($000004E8)

#WRITE(PTR, $0000038E)
【葉月】
「はい、お疲れ様でした」
<END>

#WRITE(PTR, $0000039E)
最後の設問にチェックをし終えたと同時に、僕がなにも言ってないのに葉月さんが声をかけてきた。
<END>

#WRITE(PTR, $000003AE)
ずっと見られてて、すごく恥ずかしかった。顔が紅くなってたかもしれない。
<END>

#WRITE(PTR, $000003BE)
だから僕は葉月さんの方は見ないようにして、おとなしくチェックシートを手渡した。裏面に自分の症状を書き込む暇はなかった。
<END>

#WRITE(PTR, $000003D6)
【葉月】
「それでは、待合室でお待ちください」
<END>

#WRITE(PTR, $000003E6)
【葉月】
「お薬が出てますから」
<END>

#WRITE(PTR, $000003F6)
【拓巳】
「え？　く、薬……？」
<END>

#WRITE(PTR, $00000406)
薬が出るの？
<LINE>
先生はそんなこと一言も言ってなかったけど……。
<END>

#WRITE(PTR, $0000045E)
【葉月】
「ええ、先生の指示で。弱い精神安定剤です。ぐっすり眠れるようになるし、副作用などもありませんよ」
<END>

#WRITE(PTR, $0000046E)
なるほど。さすが先生だ。気が利く。
<LINE>
でもまたあのロビーで待たされると思うと、憂鬱な気分になった。
<END>


